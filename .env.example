# Supabase Database Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git - it's in .gitignore

# Your Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Your Supabase Anon/Public Key (from Settings > API)
SUPABASE_ANON_KEY=your-anon-key-here

# Your Supabase Service Role Key (from Settings > API) - KEEP SECRET!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Direct Database Connection (optional - for scripts)
# Format: postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.xxxxx.supabase.co:5432/postgres

# Payment Testing
# Set to 'true' to test payments without real M-Pesa (mock mode)
# Set to 'false' when you have real M-Pesa credentials configured
VITE_MOCK_PAYMENT_MODE=true
